# ==============================================================================
# Authentik Access Manager - Environment Configuration
# ==============================================================================

# --- App Settings ---
APP_NAME="Authentik Access Manager"
APP_HOST=127.0.0.1
APP_PORT=8000
# Leave blank to automatically generate and persist a secure random secret key in data/.secret_key
SECRET_KEY=
SQLITE_DB_PATH=data/manager.db

# --- Authentik Connection ---
# The base URL of your Authentik instance (e.g. https://auth.homelab.local or http://192.168.1.50:9000)
AUTHENTIK_URL=https://authentik.company
# Create this in Authentik: Directory -> Users -> Service Accounts (or Admin User) -> Tokens
AUTHENTIK_TOKEN=your_authentik_api_bearer_token_here
# Set to 'true' if using a self-signed or untrusted internal TLS certificate
AUTHENTIK_INSECURE_SKIP_VERIFY=false

# --- RBAC & Group Provisioning Options ---
# Prefix used when auto-provisioning access groups for applications
APP_GROUP_PREFIX="App - "
# Authentik flow slug used for invite URLs
DEFAULT_ENROLLMENT_FLOW="default-enrollment-flow"

# --- Tool Security & Authentication Mode ---
# Options:
#  - 'password': Basic password gate using ADMIN_PASSWORD (recommended default)
#  - 'forward_auth': Forward-Auth headers (X-authentik-username) via Authentik Outpost proxy
#  - 'oidc': Full OpenID Connect SSO login via Authentik OAuth2 provider
#  - 'none': Open access (NOT recommended for production environments)
AUTH_METHOD=password
# Leave blank to generate a secure one-time password on first start (saved in data/.initial_admin_password)
ADMIN_PASSWORD=
COOKIE_SECURE=false

# --- Authentik OIDC Configuration (Required if AUTH_METHOD=oidc) ---
# In Authentik: Applications -> Providers -> Create OAuth2/OpenID Provider
# Redirect URI should be: https://manager.yourdomain.local/api/auth/oidc/callback
OIDC_ISSUER_URL=https://authentik.company/application/o/authentik-manager/
OIDC_CLIENT_ID=your_client_id_here
OIDC_CLIENT_SECRET=your_client_secret_here
OIDC_REDIRECT_URI=https://manager.company.local/api/auth/oidc/callback
# Name of the Authentik group required to log in to this manager
OIDC_ADMIN_GROUP="authentik Admins"

# --- Forward-Auth / Reverse Proxy Configuration ---
# Only requests connecting directly from these trusted IP addresses or CIDRs will have their
# X-Forwarded-For and X-authentik-* headers trusted. Defaults to loopback only (127.0.0.1,::1).
# If running behind a reverse proxy or Docker container gateway, specify its IP (e.g. "127.0.0.1,::1,172.18.0.1").
FORWARD_AUTH_TRUSTED_PROXIES=127.0.0.1,::1

# --- WhatsApp Messaging (via Baileys Microservice) ---
WHATSAPP_ENABLED=true
WHATSAPP_SERVICE_URL=http://127.0.0.1:3001
# Default country code when numbers are entered in local format (e.g. 44 for UK, 1 for US/CA)
DEFAULT_COUNTRY_CODE=44

# --- Demo / Testing Mode ---
# Set to true to populate the dashboard with mock apps, users, and groups for testing
DEMO_MODE=false
